{
  "expo": {
    "name": "MozHost",
    "slug": "mozhost-app",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mozhost",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#1e3a5f",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eliobrostech.mozhost"
    },
    "android": {
     "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#1e3a5f"
      },
      "package": "com.eliobrostech.mozhost",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1e3a5f"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd7504bb-7506-42d9-b140-85313fe17a07"
      }
    }
  }
}

