// utils/docker-manager.js
const Docker = require('dockerode');
const fs = require('fs-extra');
const path = require('path');
const { v4: uuidv4 } = require('uuid');
const database = require('../models/database');

class DockerManager {
  constructor() {
    this.docker = new Docker({ socketPath: '/var/run/docker.sock' });
    this.userDataPath = process.env.USER_DATA_PATH || '/root/mozhost/user-data';
    this.containersPath = path.join(this.userDataPath, 'containers');

    this.portRange = { min: 4000, max: 5000 };
  }

  async createUserContainer(userId, containerData) {
    const { name, type, environment = {} } = containerData;
    const containerId = uuidv4();

    try {
      // Criar pasta do container
      const containerPath = path.join(this.containersPath, containerId);
      await fs.ensureDir(containerPath);

      // Achar porta disponível
      const port = await this.findAvailablePort();

      // Configuração da imagem
      const imageConfig = this.getImageConfig(type);

      // Diretório de trabalho correto
      const workingDir = type === 'php' ? '/var/www/html' : '/app/code';
      const volume = `${containerPath}:${workingDir}:rw`;

      const containerConfig = {
        Image: imageConfig.image,
        name: `mozhost_${containerId}`,
        ExposedPorts: { [`${imageConfig.internalPort}/tcp`]: {} },
        HostConfig: {
          PortBindings: { [`${imageConfig.internalPort}/tcp`]: [{ HostPort: String(port) }] },
          RestartPolicy: { Name: 'unless-stopped' },
          Binds: [volume],
          Memory: parseInt(process.env.MAX_RAM_PER_CONTAINER || 512) * 1024 * 1024,
          CpuQuota: parseInt(parseFloat(process.env.MAX_CPU_PER_CONTAINER || '0.5') * 100000),
          CpuPeriod: 100000
        },
        WorkingDir: workingDir,
        Env: [
          `PORT=${imageConfig.internalPort}`,
          ...Object.entries(environment).map(([k, v]) => `${k}=${v}`)
        ],
        Cmd: imageConfig.cmd
      };

      // Criar container
      const container = await this.docker.createContainer(containerConfig);

      // Buscar username
      const userInfo = await database.query("SELECT username FROM users WHERE id = ?", [userId]);
      const username = userInfo[0]?.username || "user";

      // Criar subdomínio
      const subdomain = `${username}-${name}`
        .toLowerCase()
        .replace(/[^a-z0-9-]/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-|-$/g, "");

      const domain = `${subdomain}.mozhost.topaziocoin.online`;

      // Salvar no banco
      await database.query(
        "INSERT INTO containers (id, user_id, name, type, docker_container_id, port, domain, status) VALUES (?, ?, ?, ?, ?, ?, ?, 'stopped')",
        [containerId, userId, name, type, container.id, port, domain]
      );

      // Criar arquivos iniciais
      await this.createInitialFiles(containerPath, type);

      return {
        id: containerId,
        dockerId: container.id,
        port,
        domain,
        path: containerPath,
        status: "stopped"
      };

    } catch (error) {
      console.error("Error creating container:", error);
      throw new Error("Failed to create container: " + error.message);
    }
  }

  async startContainer(containerId) {
    try {
      const info = await database.query(
        "SELECT docker_container_id FROM containers WHERE id = ?",
        [containerId]
      );

      if (!info.length) throw new Error("Container not found");

      const container = this.docker.getContainer(info[0].docker_container_id);
      await container.start();

      await database.query(
        "UPDATE containers SET status='running', updated_at=NOW() WHERE id=?",
        [containerId]
      );

      return { success: true, status: "running" };
    } catch (err) {
      await database.query("UPDATE containers SET status='error' WHERE id=?", [containerId]);
      throw err;
    }
  }

  async stopContainer(containerId) {
    try {
      const info = await database.query(
        "SELECT docker_container_id FROM containers WHERE id = ?",
        [containerId]
      );

      if (!info.length) throw new Error("Container not found");

      const container = this.docker.getContainer(info[0].docker_container_id);
      await container.stop();

      await database.query(
        "UPDATE containers SET status='stopped', updated_at=NOW() WHERE id=?",
        [containerId]
      );

      return { success: true, status: "stopped" };
    } catch (err) {
      console.error("Error stopping container:", err);
      throw err;
    }
  }

  async deleteContainer(containerId) {
    try {
      const info = await database.query(
        "SELECT docker_container_id FROM containers WHERE id=?",
        [containerId]
      );

      if (info.length) {
        const container = this.docker.getContainer(info[0].docker_container_id);
        try { await container.stop(); } catch {}
        await container.remove();
      }

      await database.query("DELETE FROM containers WHERE id=?", [containerId]);

      const containerPath = path.join(this.containersPath, containerId);
      await fs.remove(containerPath);

      return { success: true };
    } catch (err) {
      console.error("Error deleting container:", err);
      throw err;
    }
  }

  async getContainerLogs(containerId, tail = 100) {
    try {
      const info = await database.query(
        "SELECT docker_container_id FROM containers WHERE id=?",
        [containerId]
      );

      if (!info.length) throw new Error("Container not found");

      const container = this.docker.getContainer(info[0].docker_container_id);
      const logs = await container.logs({
        stdout: true,
        stderr: true,
        timestamps: true,
        tail
      });

      return logs.toString();
    } catch (err) {
      console.error("Error getting logs:", err);
      throw err;
    }
  }

  async findAvailablePort() {
    for (let port = this.portRange.min; port <= this.portRange.max; port++) {
      const used = await database.query("SELECT id FROM containers WHERE port=?", [port]);
      if (!used.length) return port;
    }
    throw new Error("No ports available");
  }

  getImageConfig(type) {
    return {
      nodejs: {
        image: "node:18-alpine",
        internalPort: 3000,
        cmd: ["sh", "-c", "cd /app/code && npm install && npm start"]
      },
      python: {
        image: "python:3.11-alpine",
        internalPort: 8000,
        cmd: ["sh", "-c", "cd /app/code && pip install -r requirements.txt && python main.py"]
      },
      php: {
        image: "php:8.3-apache",
        internalPort: 80,
        cmd: ["apache2-foreground"]
      }
    }[type];
  }

  async createInitialFiles(containerPath, type) {
    const templates = {
      nodejs: {
        "package.json": JSON.stringify({
          name: "mozhost-app",
          version: "1.0.0",
          main: "index.js",
          scripts: { start: "node index.js" },
          dependencies: { express: "^4.18.2" }
        }, null, 2),

        "index.js": `
const express = require('express');
const app = express();
const PORT = process.env.PORT || 3000;

app.get('/', (req, res) => {
  res.json({
    message: 'Hello from MozHost!',
    timestamp: new Date().toISOString()
  });
});

app.listen(PORT, () => console.log('Server running on port ' + PORT));
`
      },

      python: {
        "requirements.txt": `flask==2.3.3`,

        "main.py": `
from flask import Flask, jsonify
from datetime import datetime
import os

app = Flask(__name__)
PORT = int(os.environ.get('PORT', 8000))

@app.route('/')
def home():
    return jsonify({
        'message': 'Hello from MozHost!',
        'timestamp': datetime.now().isoformat()
    })

app.run(host='0.0.0.0', port=PORT)
`
      },

      php: {
        "index.php": `<?php
header("Content-Type: application/json");

echo json_encode([
  "success" => true,
  "message" => "Hello from MozHost!",
  "language" => "PHP",
  "version" => PHP_VERSION,
  "timestamp" => date("Y-m-d H:i:s")
], JSON_PRETTY_PRINT);
?>`,

        ".htaccess": `DirectoryIndex index.php

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>
`
      }
    };

    const files = templates[type];
    for (const [filename, content] of Object.entries(files)) {
      await fs.writeFile(path.join(containerPath, filename), content);
    }
  }
}

module.exports = new DockerManager();
