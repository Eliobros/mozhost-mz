{
  "private": true,
  "name": "mozhost-desktop",
  "description": "MozHost - Plataforma de Hospedagem de Containers e APIs",
  "version": "1.0.0",
  "author": "MozHost <mozhost@topaziocoin.online>",
  "main": "main/background.js",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.2.4",
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0",
    "geist": "^1.7.0",
    "lucide-react": "^1.14.0",
    "mysql2": "^3.22.3",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.4",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "next": "^14.2.4",
    "nextron": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "mz.co.mozhost",
    "productName": "MozHost",
    "files": [
      "app",
      "renderer/out"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    }
  }
}
