# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha_do_banco
DB_NAME=mozhost
DB_SSL=false

# JWT
JWT_SECRET=sua_chave_jwt_super_secreta_aqui
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,https://mozhost.shop

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Email (Brevo)
BREVO_API_KEY=sua_chave_brevo_aqui
FROM_EMAIL=noreply@mozhost.shop
FROM_NAME=MozHost

# URLs
FRONTEND_URL=https://mozhost.shop

# Códigos de Verificação
EMAIL_CODE_TTL_MIN=15
RESET_TTL_MIN=15

# Admin
ADMIN_PASSWORD=Cadeira33@

# OAuth - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_CALLBACK_URL=https://api.mozhost.shop/api/auth/google/callback

# OAuth - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=seu_github_client_id
GITHUB_CLIENT_SECRET=seu_github_client_secret
GITHUB_CALLBACK_URL=https://api.mozhost.shop/api/auth/github/callback

# Servidor
PORT=3001
NODE_ENV=production

# WhatsApp (Cloud API oficial da Meta / Graph API)
# ==================================================
# Antigamente usava Baileys (QR Code). Agora usa a API oficial:
# 1. Crie o app no developers.facebook.com
# 2. Vincule a WABA e o número de telefone
# 3. Gere um token permanente (System User) e copie o Phone Number ID
# 4. Em WhatsApp > Configuration > Webhook, cadastre:
#      Callback URL: https://api.mozhost.shop/webhook/whatsapp
#      Verify token: o mesmo valor de WHATSAPP_WEBHOOK_VERIFY_TOKEN abaixo
WHATSAPP_ACCESS_TOKEN=seu_token_permanente_da_meta
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=escolha_um_token_secreto
# App Secret do app da Meta — usado para validar a assinatura X-Hub-Signature-256
# dos webhooks (recomendado em produção). Deixe vazio se quiser desativar a validação.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0
# Template aprovado (obrigatório p/ mensagens iniciadas pelo bot fora da janela 24h,
# ex.: código de verificação de conta). Deixe vazio se não usar.
# Se vazio (ex.: empresa ainda não verificada na Meta), o código de verificação
# de conta é entregue quando o usuário inicia a conversa: o frontend mostra um
# link wa.me e o webhook envia o código pendente automaticamente.
WHATSAPP_VERIFY_TEMPLATE_NAME=
WHATSAPP_VERIFY_TEMPLATE_LANG=pt_PT

# Agentes de suporte (número do WhatsApp dos agentes)
# SUPPORT_AGENT_NUMBERS=258840075123,258840075124

# Gemini AI (Function Calling)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Web Push (VAPID)
VAPID_PUBLIC_KEY=gere_com_web-push_generate_vapid_keys
VAPID_PRIVATE_KEY=gere_com_web-push_generate_vapid_keys
VAPID_EMAIL=suporte@mozhost.com