# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha_do_banco
DB_NAME=mozhost
DB_SSL=false

# JWT
JWT_SECRET=sua_chave_jwt_super_secreta_aqui
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,https://mozhost.shop

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Email (Brevo)
BREVO_API_KEY=sua_chave_brevo_aqui
FROM_EMAIL=noreply@mozhost.shop
FROM_NAME=MozHost

# URLs
FRONTEND_URL=https://mozhost.shop

# Códigos de Verificação
EMAIL_CODE_TTL_MIN=15
RESET_TTL_MIN=15

# Admin
ADMIN_PASSWORD=Cadeira33@

# OAuth - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_CALLBACK_URL=https://api.mozhost.shop/api/auth/google/callback

# OAuth - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=seu_github_client_id
GITHUB_CLIENT_SECRET=seu_github_client_secret
GITHUB_CALLBACK_URL=https://api.mozhost.shop/api/auth/github/callback

# Servidor
PORT=3001
NODE_ENV=production

# WhatsApp (Baileys)
# Não precisa de configuração adicional - o Baileys conecta automaticamente
# Os dados de autenticação são salvos em backend/.auth/whatsapp/

# Gemini AI (Function Calling)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Web Push (VAPID)
VAPID_PUBLIC_KEY=gere_com_web-push_generate_vapid_keys
VAPID_PRIVATE_KEY=gere_com_web-push_generate_vapid_keys
VAPID_EMAIL=suporte@mozhost.com